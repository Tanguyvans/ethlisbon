# ── Required: at least one LLM provider key ─────────────────────────────────

# Recommended: OpenRouter (access to all models via one key)
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# Or: direct OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Or: direct Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# ── Optional: Tool APIs ──────────────────────────────────────────────────────

# Web search (pick one or more)
EXA_API_KEY=
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=

# Image generation
FAL_KEY=

# Cross-session user modeling
HONCHO_API_KEY=

# GitHub (higher rate limits for code tools)
GITHUB_TOKEN=

# ── Optional: Browser automation ─────────────────────────────────────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── Hedera Tokenization Platform ─────────────────────────────────────────────
# Server-side operator/treasury credentials. Never expose the private key to
# browser code or paste it into an agent conversation.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=

# Public Reown/WalletConnect project identifier, loaded by the browser at runtime
WALLETCONNECT_PROJECT_ID=

# World ID policy configured by the Setup form.
COMPLIANCE_WORLDID_REQUIRED=false
COMPLIANCE_WORLDID_SELFIE_CHECK=true
COMPLIANCE_WORLDID_IDENTITY_CHECK=false
COMPLIANCE_WORLDID_AGE_ENABLED=false
COMPLIANCE_WORLDID_MINIMUM_AGE=18
COMPLIANCE_WORLDID_NATIONALITY_ENABLED=false
# Optional ISO 3166-1 alpha-3 nationality, e.g. PRT, USA, JPN.
COMPLIANCE_WORLDID_NATIONALITY=

# Optional canonical URL used in wallet DApp metadata
# TOKENIZATION_APP_URL=https://your-service.up.railway.app/tokenization

# ── Graph / Subgraph (graph_experiments) ─────────────────────────────────────
# Lets the agent (re)deploy a subgraph indexing an arbitrary set of ERC20
# tokens (Sepolia today -- The Graph doesn't index Hedera yet) and query the
# indexed data via the "graph" MCP server. The subgraph must already exist in
# Graph Studio (https://thegraph.com/studio/) under GRAPH_SUBGRAPH_NAME --
# Studio doesn't create subgraphs via the CLI, only via its web UI. Deploy key
# comes from that subgraph's own page in Studio.
GRAPH_DEPLOY_KEY=
GRAPH_SUBGRAPH_NAME=sepolia-test
# Optional, ONE-TIME bootstrap only: if you already have a synced subgraph in
# Studio, set this so queries work before the agent's first deploy. It is
# read exactly once -- at first boot on a brand-new volume -- and copied into
# a file on the persistent volume (SUBGRAPH_DIR/.query-url); after that the
# graph MCP owns that file and keeps it current itself after every redeploy
# (Studio's query URL embeds a version label that changes on each deploy).
# This variable is never read again after the first boot, so leaving a
# now-stale value here does no harm -- update it in Railway if you ever want
# to re-seed a *fresh* volume, not to fix a running one.
SUBGRAPH_URL=
# Optional: override the public Sepolia RPC used by get_latest_sepolia_block.
# SEPOLIA_RPC_URL=

# ── Gateway security ──────────────────────────────────────────────────────────
# Set to false and configure allowlists if you want to restrict access
GATEWAY_ALLOW_ALL_USERS=true

# ── Terminal backend ──────────────────────────────────────────────────────────
# Options: local, docker, modal, ssh
TERMINAL_ENV=local
TERMINAL_TIMEOUT=60
