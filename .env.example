# Create these values in the World Developer Portal.
NEXT_PUBLIC_WORLD_APP_ID=app_xxxxx
WORLD_RP_ID=rp_xxxxx
WORLD_RP_SIGNING_KEY=0x...

# The action must match the action configured for the app.
WORLD_ACTION=selfie-check-demo

# staging = web simulator; sandbox = mobile Sandbox build; production = live app.
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging

# Optional app-specific value bound into the proof.
NEXT_PUBLIC_WORLD_SIGNAL=selfie-demo-user

# Full RP context, IDKit payload and World API response in the local terminal.
# Never enabled in production, even when set to true.
WORLD_DEBUG_LOGS=true
